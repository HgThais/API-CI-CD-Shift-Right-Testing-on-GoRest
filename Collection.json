  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nlet responseData = pm.response.json();\r\n\r\npm.test(\"Response body contains valid user ID and created email\", function () {\r\n    pm.expect(responseData).to.have.property(\"id\");\r\n    pm.expect(responseData.id).to.be.a(\"number\");\r\n});\r\n\r\npm.environment.set(\"userId\", responseData.id);\r\npm.environment.set(\"createdEmail\", responseData.email);\r\nconsole.log(\"Extracted userId:\", responseData.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let rawEmail = pm.iterationData.get(\"email\");\r\nlet dynamicEmail = Date.now() + \"_\" + rawEmail;\r\npm.variables.set(\"dynamic_email\", dynamicEmail);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{name}}\",\n    \"gender\": \"{{gender}}\",\n    \"email\": \"{{dynamic_email}}\",\n    \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Check User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nlet responseData = pm.response.json();\r\nlet expectedUserId = pm.environment.get(\"userId\");\r\n\r\npm.test(\"Verify returned User ID matches the created ID\", function () {\r\n    pm.expect(responseData.id).to.eql(expectedUserId);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Status User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nlet responseData = pm.response.json();\r\n\r\npm.test(\"Verify user status updated to inactive\", function () {\r\n    pm.expect(responseData.status).to.eql(\"inactive\");\r\n});"
                ]
              }
            }
          ],
